{
  "openapi": "3.1.0",
  "info": {
    "title": "SensorLab data API",
    "version": "0.1.0",
    "description": "SQLite-backed water-flow research starter. All times stored in UTC. Missing calibration is null. Analytics are descriptive statistics, not a trained data-mining model."
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Public liveness and running release",
        "security": [],
        "responses": {
          "200": {
            "description": "Service available"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Public database readiness and schema version",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/api/v1/readings": {
      "post": {
        "summary": "Insert an atomic batch; 201 new rows, 200 identical retry, 409 conflicting ID",
        "description": "Access: device/admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          },
          "201": {
            "description": "Measurements inserted"
          },
          "409": {
            "description": "ID reused with different content; whole batch rolled back"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ingestion"
              }
            }
          }
        }
      },
      "get": {
        "summary": "Cursor-paginated raw measurements",
        "description": "Access: viewer/admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          }
        },
        "parameters": [
          {
            "name": "device_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional device filter"
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Inclusive server-received UTC time (ISO 8601 with timezone)"
          },
          {
            "name": "until",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Inclusive server-received UTC time (ISO 8601 with timezone)"
          },
          {
            "name": "after_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        ]
      }
    },
    "/api/v1/readings.csv": {
      "get": {
        "summary": "CSV export, max 10000 rows; X-Has-More and X-Next-After-Id headers",
        "description": "Access: viewer/admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          }
        },
        "parameters": [
          {
            "name": "device_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional device filter"
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Inclusive server-received UTC time (ISO 8601 with timezone)"
          },
          {
            "name": "until",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Inclusive server-received UTC time (ISO 8601 with timezone)"
          },
          {
            "name": "after_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        ]
      }
    },
    "/api/v1/devices": {
      "get": {
        "summary": "Devices and their last new measurement time",
        "description": "Access: viewer/admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/api/v1/dashboard": {
      "get": {
        "summary": "Latest 240 samples and window summary for one device",
        "description": "Access: viewer/admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          }
        },
        "parameters": [
          {
            "name": "device_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 168,
              "default": 24
            }
          }
        ]
      }
    },
    "/api/v1/analytics": {
      "get": {
        "summary": "Per-device time buckets: count, min/max/mean frequency, mean flow and calibration coverage",
        "description": "Access: viewer/admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          }
        },
        "parameters": [
          {
            "name": "device_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional device filter"
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Inclusive server-received UTC time (ISO 8601 with timezone)"
          },
          {
            "name": "until",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Inclusive server-received UTC time (ISO 8601 with timezone)"
          },
          {
            "name": "bucket_minutes",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 15
            }
          }
        ]
      }
    },
    "/api/v1/feedback": {
      "post": {
        "summary": "Save research or user feedback linked to a device/reading",
        "description": "Access: viewer/admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          },
          "201": {
            "description": "Feedback saved"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Feedback"
              }
            }
          }
        }
      },
      "get": {
        "summary": "Paginated feedback records",
        "description": "Access: admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          }
        },
        "parameters": [
          {
            "name": "after_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        ]
      }
    },
    "/api/v1/system": {
      "get": {
        "summary": "Database, schema, record counts and release",
        "description": "Access: admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/api/v1/system/check": {
      "post": {
        "summary": "Test a database write and read, then roll back the probe",
        "description": "Access: admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/api/v1/spec": {
      "get": {
        "summary": "This API contract",
        "description": "Access: viewer/admin. Browser sessions may read; browser writes also require X-CSRF-Token. External clients use Authorization: Bearer <role-key>.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid authentication"
          },
          "403": {
            "description": "Role or CSRF check failed"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/api/v1/living/activities": {
      "get": {
        "summary": "Fixed synthetic activity scenario (viewer/admin)",
        "responses": {
          "200": {
            "description": "Synthetic records, named-reference comparison, coverage and KDE from the same selected records. No research DB writes."
          },
          "400": {
            "description": "Unsupported fields, correction or range"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Viewer/admin required; session POSTs require X-CSRF-Token"
          }
        }
      }
    },
    "/api/v1/living/activities/preview": {
      "post": {
        "summary": "Recalculate the demo from bounded corrections; no persistence",
        "description": "Dates are fixed demo periods. Unknown emissions remain null and excluded. Corrections are explicit selections, not sensor calibration or real purchases. Browser callers need CSRF.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "period": {
                    "enum": [
                      "week",
                      "fortnight"
                    ],
                    "default": "week"
                  },
                  "scope": {
                    "enum": [
                      "all",
                      "inside",
                      "outside"
                    ]
                  },
                  "category": {
                    "enum": [
                      "all",
                      "energy",
                      "water",
                      "transport",
                      "shopping",
                      "food",
                      "other"
                    ]
                  },
                  "bandwidth_m": {
                    "enum": [
                      250,
                      500,
                      750,
                      1250,
                      2000
                    ]
                  },
                  "corrections": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "mode"
                          ],
                          "properties": {
                            "id": {
                              "enum": [
                                "rail-01",
                                "trip-02"
                              ]
                            },
                            "mode": {
                              "enum": [
                                "mtr",
                                "bus",
                                "car",
                                "skip"
                              ]
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "catalogue"
                          ],
                          "properties": {
                            "id": {
                              "const": "purchase-02"
                            },
                            "catalogue": {
                              "enum": [
                                "shampoo",
                                "noodles"
                              ]
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "litres",
                            "minutes"
                          ],
                          "properties": {
                            "id": {
                              "const": "shower-01"
                            },
                            "litres": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 1000
                            },
                            "minutes": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 120
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synthetic records, named-reference comparison, coverage and KDE from the same selected records. No research DB writes."
          },
          "400": {
            "description": "Unsupported fields, correction or range"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Viewer/admin required; session POSTs require X-CSRF-Token"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Measurement": {
        "type": "object",
        "required": [
          "seq",
          "uptime_us",
          "dt_us",
          "pulses",
          "total_pulses",
          "frequency_hz"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "uptime_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "pulses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "total_pulses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "dt_us": {
            "type": "integer",
            "minimum": 1
          },
          "frequency_hz": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "flow_lpm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "total_l": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "pulse": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "hz",
                  "high_us",
                  "low_us",
                  "duty_pct"
                ],
                "properties": {
                  "hz": {
                    "type": "number",
                    "minimum": 0
                  },
                  "high_us": {
                    "type": "number",
                    "minimum": 0
                  },
                  "low_us": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duty_pct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "description": "Additional finite JSON fields are retained in raw. Use a new boot_id after a counter reset. Exact retries deduplicate; conflicting measurement IDs return 409."
      },
      "Ingestion": {
        "type": "object",
        "required": [
          "device_id",
          "boot_id",
          "samples"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "boot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Measurement"
            }
          }
        }
      },
      "Feedback": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "device_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reading_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "category": {
            "enum": [
              "research",
              "sensor",
              "usability",
              "bug"
            ]
          },
          "rating": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
