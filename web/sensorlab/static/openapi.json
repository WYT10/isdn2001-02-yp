  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Measurement": {
        "type": "object",
        "required": [
          "seq",
          "uptime_us",
          "dt_us",
          "pulses",
          "total_pulses",
          "frequency_hz"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "uptime_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "pulses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "total_pulses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "dt_us": {
            "type": "integer",
            "minimum": 1
          },
          "frequency_hz": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "flow_lpm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "total_l": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "pulse": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "hz",
                  "high_us",
                  "low_us",
                  "duty_pct"
                ],
                "properties": {
                  "hz": {
                    "type": "number",
                    "minimum": 0
                  },
                  "high_us": {
                    "type": "number",
                    "minimum": 0
                  },
                  "low_us": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duty_pct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "description": "Additional finite JSON fields are retained in raw. Use a new boot_id after a counter reset. Exact retries deduplicate; conflicting measurement IDs return 409."
      },
      "Ingestion": {
        "type": "object",
        "required": [
          "device_id",
          "boot_id",
          "samples"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "boot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Measurement"
            }
          }
        }
      },
      "Feedback": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "device_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reading_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "category": {
            "enum": [
              "research",
              "sensor",
              "usability",
              "bug"
            ]
          },
          "rating": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
